<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      DayNight + AppCompatDelegate lets in-app Light/Dark follow user choice instead of
      system "extended dark" / force-dark tinting light UIs on newer Android releases.
    -->
    <style name="Theme.FilePipe" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.FilePipe.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#CBDEF6</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.FilePipe</item>
    </style>
</resources>
